DATABASE_URL=postgresql+psycopg2://ztauth:ztauth@localhost:5432/ztauth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=30

TRUST_ALLOW_THRESHOLD=70
TRUST_STEPUP_THRESHOLD=40
DEMO_OTP=123456

# local | s3 -- use s3 when deployed on AWS (see infra/)
MODEL_STORE=local
MODEL_STORE_LOCAL_DIR=./model_store_data
MODEL_STORE_S3_BUCKET=
MODEL_STORE_S3_REGION=us-east-1

GEOLOCATION_ENABLED=true
